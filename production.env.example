# Sridattam production configuration for docker-compose.prod.yml
# On the VPS: copy to .env (`deploy.sh` does this and generates the random secrets),
# fill in every empty value, and never commit the real .env.

# ─── Domains (DNS A records must point at the VPS) ────────────────────────────
SITE_DOMAIN=sridattam.in
ADMIN_DOMAIN=admin.sridattam.in
API_DOMAIN=api.sridattam.in

# Public URLs — keep in sync with the domains above (https, no trailing slash)
FRONTEND_URL=https://sridattam.in
ADMIN_URL=https://admin.sridattam.in
BACKEND_PUBLIC_URL=https://api.sridattam.in

# ─── Generated by deploy.sh (openssl rand) — leave empty to auto-generate ─────
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=
REVALIDATE_SECRET=

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=sridattam
POSTGRES_DB=sridattam
DB_POOL_MAX=25

# ─── Cloudflare R2 ────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sridattam-product-media
R2_PUBLIC_BASE_URL=

# ─── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=console
EMAIL_FROM=Sridattam <noreply@sridattam.in>
EMAIL_BRAND_NAME=Sridattam
EMAIL_LOGO_URL=
INTERNAL_ALERT_EMAILS=
SUPPORT_EMAIL=
SUPPORT_PHONE=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ─── Monitoring ───────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
