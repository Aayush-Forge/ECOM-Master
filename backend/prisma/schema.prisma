// =========================
// ENUMS
// =========================

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ClubbingRuleType {
  FIXED_PRICE_BUNDLE
  PERCENTAGE_OFF_BUNDLE
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

// =========================
// CATEGORY
// =========================

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid

  name      String
  slug      String   @unique

  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")

  products Product[]

  clubbingRules ClubbingRule[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([parentId])

  @@map("categories")
}

// =========================
// PRODUCT
// =========================

model Product {
  id               String   @id @default(uuid()) @db.Uuid

  sku              String   @unique
  title            String
  slug             String   @unique

  description      String?
  shortDescription String?  @map("short_description")

  basePrice        Decimal  @map("base_price") @db.Decimal(10, 2)
  compareAtPrice   Decimal? @map("compare_at_price") @db.Decimal(10, 2)
  salePrice        Decimal? @map("sale_price") @db.Decimal(10, 2)

  weight           Decimal? @db.Decimal(10, 2)
  length           Decimal? @db.Decimal(10, 2)
  width            Decimal? @db.Decimal(10, 2)
  height           Decimal? @db.Decimal(10, 2)

  categoryId       String   @map("category_id") @db.Uuid
  category         Category @relation(fields: [categoryId], references: [id])

  status           ProductStatus @default(DRAFT)

  images           String[]

  customFields     Json? @map("custom_fields")

  stockQuantity    Int @default(0) @map("stock_quantity")

  cartItems        CartItem[]

  clubbingRules    ClubbingRuleProduct[]

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([slug])
  @@index([categoryId])
  @@index([status])

  @@map("products")
}

// =========================
// CLUBBING RULE
// =========================

model ClubbingRule {
  id String @id @default(uuid()) @db.Uuid

  name String

  type ClubbingRuleType

  requiredQuantity Int @map("required_quantity")

  fixedPrice Decimal? @map("fixed_price") @db.Decimal(10,2)

  percentageOff Decimal? @map("percentage_off") @db.Decimal(5,2)

  applicableCategoryId String? @map("applicable_category_id") @db.Uuid

  applicableCategory Category? @relation(fields: [applicableCategoryId], references: [id])

  products ClubbingRuleProduct[]

  startsAt DateTime? @map("starts_at")

  endsAt DateTime? @map("ends_at")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([startsAt])
  @@index([endsAt])

  @@map("clubbing_rules")
}

// =========================
// CLUBBING RULE PRODUCTS
// MANY TO MANY
// =========================

model ClubbingRuleProduct {
  ruleId String @map("rule_id") @db.Uuid

  productId String @map("product_id") @db.Uuid

  rule ClubbingRule @relation(fields: [ruleId], references: [id])

  product Product @relation(fields: [productId], references: [id])

  @@id([ruleId, productId])

  @@map("clubbing_rule_products")
}

// =========================
// CART
// =========================

model Cart {
  id String @id @default(uuid()) @db.Uuid

  customerId String? @map("customer_id") @db.Uuid

  customer User? @relation(fields: [customerId], references: [id])

  sessionToken String? @unique @map("session_token")

  status CartStatus @default(ACTIVE)

  items CartItem[]

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([customerId])

  @@map("carts")
}

// =========================
// CART ITEM
// =========================

model CartItem {
  id String @id @default(uuid()) @db.Uuid

  cartId String @map("cart_id") @db.Uuid

  productId String @map("product_id") @db.Uuid

  quantity Int

  unitPriceSnapshot Decimal @map("unit_price_snapshot") @db.Decimal(10,2)

  cart Cart @relation(fields: [cartId], references: [id])

  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])

  @@map("cart_items")
}