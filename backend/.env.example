# ─── Server & Environment ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecom_db?schema=public
POSTGRES_USER=sridattam_admin
POSTGRES_PASSWORD=sridattam_secure_pass_2026
POSTGRES_DB=sridattam_dev_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=

# ─── Cloudflare R2 Object Storage ─────────────────────────────────────────────
# All stored objects are public-read. No signed/private URL support.
#
# R2_ACCOUNT_ID       — found in the Cloudflare dashboard (R2 → Overview)
# R2_ACCESS_KEY_ID    — R2 API token "Access Key ID"
# R2_SECRET_ACCESS_KEY— R2 API token "Secret Access Key"
# R2_BUCKET_NAME      — bucket name as created in the Cloudflare dashboard
# R2_PUBLIC_BASE_URL  — public URL prefix for objects.
#                       Currently the default r2.dev URL; may change to a
#                       custom domain later. Because URLs are constructed
#                       dynamically from this variable (callers never store
#                       full URLs), switching requires only an env-var update —
#                       no code changes, no data migrations.
#
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=       # e.g. https://pub-xxxx.r2.dev

# ─── Razorpay Payment Gateway ────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Email & Notifications ───────────────────────────────────────────────────
EMAIL_PROVIDER=console        # "console" (default). Production provider SDK to be configured later.
EMAIL_FROM=noreply@sridattam.com
EMAIL_BRAND_NAME=Sridattam    # Brand name used in email templates and footers (default: Sridattam)
INTERNAL_ALERT_EMAILS=        # Comma-separated internal recipient addresses for order/failure alerts
EMAIL_DEBUG=false             # Set to "true" to log full email HTML/text bodies in console provider
